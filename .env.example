# Jestly — variables d'environnement (SANS valeurs — copie vers .env.local)
# .env* est gitignoré ; seul ce fichier d'exemple est committé.

# ── Supabase ─────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_PASSWORD=

# ── Chiffrement des secrets d'intégrations (AES-256-GCM) ────────
ENCRYPTION_KEY=

# ── Crons Vercel ─────────────────────────────────────────────────
CRON_SECRET=

# ── Google Ads API (reporting lecture seule → gads_daily) ───────
# Dev token du compte manager (niveau Explorer ou plus)
GOOGLE_ADS_DEVELOPER_TOKEN=
# ID client OAuth type « Application de bureau » (Google Cloud Console)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Généré une fois via : node scripts/gads-get-refresh-token.mjs
GOOGLE_ADS_REFRESH_TOKEN=
# Compte manager (MCC), chiffres uniquement, sans tirets
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Compte annonceur L'Horloge Murale, chiffres uniquement, sans tirets
GOOGLE_ADS_CUSTOMER_ID=
# Optionnel : version d'API (défaut v23) et user Jestly cible du cron
# GOOGLE_ADS_API_VERSION=v23
# GOOGLE_ADS_USER_ID=

# ── Pinterest Ads ────────────────────────────────────────────────
JESTLY_PINTEREST_APP_ID=
JESTLY_PINTEREST_APP_SECRET=
JESTLY_PINTEREST_REDIRECT_URI=

# ── Divers ───────────────────────────────────────────────────────
RESEND_API_KEY=
STRIPE_SECRET_KEY=
ANTHROPIC_API_KEY=
FIRECRAWL_API_KEY=
NEXT_PUBLIC_BASE_DOMAIN=
# Commandes de test exclues des analytics ECOM (ex. #1001,#1002)
EXCLUDED_ORDER_NAMES=
